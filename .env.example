DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave blank to use the local SQLite database (expansio.sqlite3).
# Railway MySQL: set DATABASE_URL=${{MySQL.MYSQL_URL}} or connect MySQL plugin variables.
# Production requires MySQL; do not put a real database URL in this file.
DATABASE_URL=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
# Use a Gmail App Password, never your normal Gmail password.
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com
