DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave blank to use the local SQLite database (expansio.sqlite3).
# Railway MySQL: set DATABASE_URL=${{MySQL.MYSQL_URL}} or connect MySQL plugin variables.
# Production requires MySQL; do not put a real database URL in this file.
DATABASE_URL=

# Email via Brevo (sign up at https://brevo.com, free tier = 300 emails/day to any recipient)
BREVO_API_KEY=xkeysib-your_api_key_here
DEFAULT_FROM_EMAIL=your-verified-email@gmail.com
