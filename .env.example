DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Leave blank to use the local SQLite database (expansio.sqlite3).
# Railway MySQL: set DATABASE_URL=${{MySQL.MYSQL_URL}} or connect MySQL plugin variables.
# Production requires MySQL; do not put a real database URL in this file.
DATABASE_URL=

# Email via Resend (sign up at https://resend.com, free tier = 100 emails/day)
RESEND_API_KEY=re_your_api_key_here
# Use onboarding@resend.dev for testing; add your own domain in Resend dashboard for production.
DEFAULT_FROM_EMAIL=onboarding@resend.dev
